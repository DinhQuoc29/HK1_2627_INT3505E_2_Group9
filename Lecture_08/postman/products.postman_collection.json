{
  "info": {
    "name": "Product Catalog API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Default listing",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Response content is correct', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.total).to.eql(1000);",
              "  pm.expect(body.items).to.have.lengthOf(10);",
              "  pm.expect(body.page).to.eql(1);",
              "  pm.expect(body.per_page).to.eql(10);",
              "  pm.expect(body.items[0]).to.have.all.keys('id', 'name', 'category', 'price_cents');",
              "  pm.expect(body.items[0].price_cents).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Filter electronics",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/products?category=electronics&per_page=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Response content is correct', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.total).to.eql(250);",
              "  pm.expect(body.items).to.have.lengthOf(5);",
              "  body.items.forEach(p => pm.expect(p.category).to.eql('electronics'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Second page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/products?page=2&per_page=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Response content is correct', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.page).to.eql(2);",
              "  pm.expect(body.items).to.have.lengthOf(10);",
              "  pm.expect(body.items[0].id).to.eql(11);",
              "  pm.expect(body.items[9].id).to.eql(20);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown category",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/products?category=nonexistent"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Response content is correct', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.total).to.eql(0);",
              "  pm.expect(body.items).to.eql([]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject page zero",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/products?page=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Response content is correct', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.eql('VALIDATION_ERROR');",
              "  pm.expect(body.message).to.include('page');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject non-integer page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/products?page=abc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Response content is correct', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.eql('VALIDATION_ERROR');",
              "  pm.expect(body.message).to.include('integers');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject excessive page size",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/products?per_page=101"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Response content is correct', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.eql('VALIDATION_ERROR');",
              "  pm.expect(body.message).to.include('100');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}