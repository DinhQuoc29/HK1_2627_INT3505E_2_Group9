POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432

# Dùng bởi backend (SQLAlchemy + psycopg 3)
DATABASE_URL=postgresql+psycopg://ecommerce:ecommerce@localhost:5432/ecommerce

# Backend auth (xem apps/backend/README.md)
# Sinh secret: python -c "import secrets; print(secrets.token_urlsafe(48))"  (>= 32 ký tự, KHÔNG commit giá trị thật)
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
COOKIE_SECURE=false
# OAuth Client ID (Web) tạo trên Google Cloud Console; origin được phép: http://localhost:5173
GOOGLE_CLIENT_ID=
