POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432

# Dùng bởi backend (SQLAlchemy + psycopg 3)
DATABASE_URL=postgresql+psycopg://ecommerce:ecommerce@localhost:5432/ecommerce

# Backend auth (xem apps/backend/README.md)
# Sinh secret: python -c "import secrets; print(secrets.token_urlsafe(48))"  (>= 32 ký tự, KHÔNG commit giá trị thật)
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
COOKIE_SECURE=false
# Số request đăng ký/đăng nhập tối đa mỗi IP mỗi phút (0 = tắt)
RATE_LIMIT_PER_MINUTE=20
# OAuth Client ID (Web) tạo trên Google Cloud Console; origin được phép: http://localhost:5173
GOOGLE_CLIENT_ID=
# Facebook Login (Meta for Developers). App ID công khai; APP_SECRET là bí mật, KHÔNG commit giá trị thật
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Email (xác minh email, quên mật khẩu, thông báo duyệt người bán)
# console: ghi nội dung email (kèm link) ra log của backend, không cần SMTP  <- mặc định cho dev
# smtp:    gửi thật; dev có thể dùng Mailpit: docker compose --profile mail up -d mailpit (xem thư ở http://localhost:8025)
EMAIL_BACKEND=console
EMAIL_FROM=E-Market <no-reply@e-market.local>
APP_BASE_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
VERIFY_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=60
EMAIL_RESEND_COOLDOWN_SECONDS=60
