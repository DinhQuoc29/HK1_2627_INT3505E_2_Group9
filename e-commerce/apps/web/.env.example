# OAuth Client ID (Web) tạo trên Google Cloud Console; Authorized JavaScript origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=
# Facebook App ID (công khai) tạo trên Meta for Developers; cần Facebook Login for Web, thêm http://localhost:5173 vào Valid OAuth Redirect/Allowed Domains
VITE_FACEBOOK_APP_ID=
